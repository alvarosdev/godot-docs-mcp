# Godot MCP Server — Environment Variables
# Copy this file to .env and adjust as needed.

# Transport: http | stdio
FASTMCP_TRANSPORT=http

# Host port mapping
FASTMCP_PORT=8000

# MCP endpoint path
FASTMCP_PATH=/mcp

# Authentication token (leave empty for open server)
# Generate a secure token with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Docs directory (default: docs)
# DOCS_DIR=docs
